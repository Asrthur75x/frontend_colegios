---
import SetupWizard from "../components/Setup/SetupWizard.jsx";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Configuración | Horarix</title>
		<script>
			import { hasUsableSession } from "../lib/auth/session";

			if (!hasUsableSession()) {
				window.location.replace("/login");
			}
		</script>
	</head>
	<body class="bg-white font-sans antialiased h-screen w-screen overflow-hidden">
		<SetupWizard client:load />
	</body>
</html>
