---
import { ClientRouter } from "astro:transitions";
import MainNavbar from "../components/MainNavbar.jsx";
import SileoToaster from "../components/SileoToaster.jsx";
import GeneracionSileoListener from "../components/Horarios/GeneracionSileoListener.jsx";
import "../styles/global.css";

const { title = "Dashboard | Horarix" } = Astro.props;
const currentPath = Astro.url.pathname;
const isHorariosRoute = currentPath.startsWith("/horarios");

// Fondo global para todas las páginas
const bodyBg = "#f8fafc";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<script>
			import { hasUsableSession } from "../lib/auth/session";

			if (!hasUsableSession()) {
				window.location.replace("/login");
			}
		</script>
		<ClientRouter />
	</head>
	<body
		class="text-[var(--color-brand-black)] font-sans antialiased h-screen overflow-hidden transition-colors duration-500"
		style={`background-color: ${bodyBg};`}
	>
		<!-- Nuevo Topbar Interactivo Global -->
		<MainNavbar client:load currentPath={currentPath} transition:persist="main-navbar" />

		<!-- Contenedor principal a pantalla completa -->
		<div
			class={`flex flex-col overflow-y-scroll overflow-x-hidden ${isHorariosRoute ? "h-[calc(100vh-8rem)] mt-32" : "h-[calc(100vh-5rem)] mt-20"}`}
		>
			<main class="p-8 flex-1 w-full max-w-screen-2xl mx-auto">
				<slot />
			</main>
		</div>
		<!-- Listener global para mostrar notificaciones de generación usando Sileo -->
		<GeneracionSileoListener client:load transition:persist="generacion-sileo-listener" />

		<!-- Sileo Dynamic Island Toasts -->
		<SileoToaster client:load transition:persist="sileo-toaster" />
	</body>
</html>
